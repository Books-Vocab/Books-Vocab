  "routes": [
    {
      "id": "bootstrap",
      "match": {"roles": ["*"]},
      "units": ["kernel.startup", "kernel.nonnegotiables", "router.bootstrap", "agent-context.bootstrap"]
    },
    {
      "id": "role.ticket-factory",
      "match": {"roles": ["ticket-factory"]},
      "units": ["agent-context.role.ticket-factory", "router.hard-stops", "receipt.core"]
