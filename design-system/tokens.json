        "ratio": 1.05
      },
      "heading": {
        "ratio": 1.2
      },
      "body": {
        "ratio": 1.5
      },
      "reading": {
        "ratio": 1.6
      },
      "caption": {
        "ratio": 1.3
      }
    }
  },
  "elevation": {
    "$comment": "Mirrors enum AppElevation z0..z4 (the app's ONLY shadow system). CSS box-shadow = '0 {y}px {radius}px rgba(0,0,0,{opacity})'. Dark mode multiplies opacity by 1.8 (AppElevationModifier darkBoost) so shadows stay visible on dark surfaces.",
    "dark-boost": 1.8,
    "steps": {
      "z0": {
        "opacity": 0,
        "blur": 0,
        "y": 0,
        "$swift": "AppElevation.z0"
      },
      "z1": {
        "opacity": 0.03,
        "blur": 4,
        "y": 1,
        "$swift": "AppElevation.z1"
      },
      "z2": {
        "opacity": 0.06,
        "blur": 10,
        "y": 4,
        "$swift": "AppElevation.z2"
      },
      "z3": {
        "opacity": 0.1,
        "blur": 18,
        "y": 8,
        "$swift": "AppElevation.z3"
      },
      "z4": {
        "opacity": 0.16,
        "blur": 28,
        "y": 14,
        "$swift": "AppElevation.z4"
      }
    }
  },
  "motion": {
    "$comment": "Three layers: (1) `duration`/`easing` mirror AppMotion timing-curve animations (easeOut/linear/timingCurve) — `emphasized-decelerate`/`follow` are DIRECT mirrors of AppMotion.timingCurve(...) control points. (2) `spring` mirrors AppMotion spring physics (response+damping, $swift-guarded); the generator derives a no-overshoot easeOutCubic CSS approximation. (3) `transition` = web-only composed shorthands. Under prefers-reduced-motion the generator emits a duration→0.01ms override for every --dur-*/--spring-*/--motion-* (web equivalent of iOS accessibilityReduceMotion).",
    "duration": {
      "quick": {
        "s": 0.15,
        "$swift": "AppMotion.quickEaseOut"
      },
      "control": {
        "s": 0.14,
        "$swift": "AppMotion.controlEaseOut"
      },
      "chip": {
        "s": 0.18,
        "$swift": "AppMotion.chipSelect"
      },
      "progress": {
        "s": 0.1,
        "$swift": "AppMotion.progressLinear"
      },
      "pulse": {
        "s": 1.4,
        "$note": "web/chrome-only loading-skeleton pulse (kg-pulse / kg-shimmer). No iOS literal — AppMotion.subtleBreath is 2.8s with autoreverse breath semantics, deliberately not reused. No $swift, so token_drift_check skips it."
      }
    },
    "easing": {
      "quick": {
        "css": "ease-out"
      },
      "control": {
        "css": "ease-out"
      },
      "chip": {
        "css": "ease-out"
      },
      "linear": {
        "css": "linear"
      },
      "emphasized-decelerate": {
        "css": "cubic-bezier(0.05, 0.7, 0.1, 1.0)",
        "$swift": "AppMotion.emphasizedDecelerate"
      },
      "follow": {
        "css": "cubic-bezier(0.65, 0.0, 0.35, 1.0)",
        "$swift": "AppMotion.podcastFollowScroll"
      }
    },
    "$comment-spring": "AppMotion spring physics mirrored as $swift-guarded response+damping. CSS has no spring solver; the generator derives `<response>s cubic-bezier(0.33,1,0.68,1)` — a no-overshoot SAFE approximation (the long-standing spring-standard route). `damping` is guarded against iOS drift and documents the SoT, but is intentionally NOT expressed in the cubic-bezier (overshoot dropped for safety); it unblocks a future linear()-easing spring upgrade. Only springs with a real cross-platform (web/chrome) consumer are mirrored — iOS-only gesture/review/celebration springs are deliberately omitted to avoid dormant tokens.",
    "spring": {
      "standard": {
        "response": 0.3,
        "damping": 0.75,
        "$swift": "AppMotion.standardSpring"
      },
      "emphasized": {
        "response": 0.35,
        "damping": 0.8,
        "$swift": "AppMotion.emphasizedSpring"
      },
      "press": {
        "response": 0.25,
        "damping": 0.65,
        "$swift": "AppMotion.pressFeedback"
      },
      "content-reveal": {
        "response": 0.35,
        "damping": 0.82,
        "$swift": "AppMotion.contentReveal"
      },
      "modal-swap": {
        "response": 0.45,
        "damping": 0.85,
        "$swift": "AppMotion.modalSwapSpring"
      }
    },
    "$comment-transition": "Composed multi-property transition shorthands — web-only convenience (no Swift literal). Mirror the SEMANTICS of AnyTransition.contentSwap (opacity+scale) / readerPanelReveal (move+opacity).",
    "transition": {
      "content-swap": "opacity 0.2s ease-out, transform 0.2s ease-out",
      "panel-reveal": "transform 0.3s ease-out, opacity 0.25s ease-out"
    },
    "$comment2": "Tap-feedback triplet (scale+opacity) — mirrors AppMotion.TapFeedback. Web drops haptic (no platform equivalent).",
    "tap-feedback": {
      "scale-down": {
        "value": 0.97,
        "$swift": "AppMotion.TapFeedback.scaleDown"
      },
      "opacity-dip": {
        "value": 0.92,
        "$swift": "AppMotion.TapFeedback.opacityDip"
      }
    }
  },
  "web-only": {
    "$comment": "Surfaces existing ONLY on web/chrome with NO iOS literal — guarded-exempt by design (no $swift; token_drift_check never iterates this block). Sub-blocks consumed by gen_web_tokens.py: theme-color → per-theme --<key> in each [data-theme] block (currently: on-success); theme-preview → cross-theme INVARIANT swatches --swatch-<theme> in :root, each pulled from another theme's color (single source, no hand-copied hex); invariant-color → same-value --<key> in :root (currently EMPTY — reserved generic extension point for genuinely theme-invariant web-only colors; the gen loop no-ops while absent).",
    "theme-color": {
      "$comment": "Per-theme web-only colors. Each entry has {light,dark,sepia} specs resolved by resolve_color (css/ref/rgb), emitted as --<key> into the matching theme block.",
      "on-success": {
        "light": { "css": "#ffffff" },
        "sepia": { "css": "#ffffff" },
        "dark": { "ref": "on-brand-hero.any" },
        "$note": "Foreground for the FILLED success button (.kg-popup__btn--success). iOS has no filled success button (success = tint-bg + text), so no AppColors mirror. Theme-aware because the success BG differs per theme: light/sepia success = #3B7A3B → white = 5.25:1 AA; dark success = #6FB36F is too light for white (2.51:1, FAILS AA) → reuse onBrandHero charcoal #1C1A17 = 7.0:1 AA. No new magic color: dark refs an existing primitive."
      }
    },
    "theme-preview": {
      "$comment": "Cross-theme preview swatches: the options theme-picker (.kg-theme-option__swatch--<t>) shows all 3 theme backgrounds at once, so each must be a CONCRETE value available under ANY active theme — a plain var(--page-bg) would only ever resolve the current theme. gen emits --swatch-<theme> = that theme's resolved `swatch-of` color into :root (invariant). Single source = color.theme.<t>.<swatch-of>; swatch auto-tracks page-bg, zero hand-copied hex.",
      "swatch-of": "page-bg",
      "themes": ["light", "dark", "sepia"]
    }
  },
  "$platform-equivalence": {
    "$comment": "Things that CANNOT be 1:1 across Swift↔CSS. Documented honestly rather than faked.",
    "spring-physics": "iOS spring(response/damping) → CSS cubic-bezier approximation (no real spring solver).",
    "haptic": "iOS UIFeedbackGenerator → no web equivalent; tap feedback is visual-only on web.",
    "sf-symbols": "iOS SF Symbols → web must supply its own icon set (inline SVG); not covered by tokens.",
    "blur-material": "iOS .ultraThinMaterial / glass → CSS backdrop-filter: blur() (approximate, perf-gated).",
    "reduce-motion": "iOS accessibilityReduceMotion → CSS @media (prefers-reduced-motion: reduce).",
    "on-demand-cjk-font": "iOS downloads STSongti-TC on demand → web ships a bundled woff2 subset OR falls back to Noto Serif TC."
  }
}
