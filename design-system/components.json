{
  "$name": "KG Cross-Platform Component Specifications",
  "$description": "Component layout/structure specifications that bridge iOS SwiftUI and web CSS. Complements design-system/tokens.json (color/font/space constants). This file is the SoT for component STRUCTURE and ALGORITHMS; tokens.json is the SoT for component MATERIAL (colors, fonts, spacing primitives).",
  "$provenance": {
    "ios_sources": [
      "ios/BooksAndVocab/Views/Vocabulary/Components/WordRow.swift",
      "ios/BooksAndVocab/Views/Vocabulary/Scenes/KGVocabPresenter.swift",
      "ios/BooksAndVocab/Views/Vocabulary/Components/VocabComponents.swift",
      "ios/BooksAndVocab/UIComponents/ListSectionCard.swift",
      "ios/BooksAndVocab/UIComponents/AppFilterChipBar.swift",
      "ios/BooksAndVocab/UIComponents/AppTabSelector.swift",
      "ios/BooksAndVocab/Models/ReviewGradient.swift"
    ],
    "rule": "Structure (flex layout, padding, line-clamp) is hand-authored here as the cross-platform contract. Material (colors, fonts) is REFERENCED via tokens.json keys so a token change auto-propagates."
  },

  "algorithms": {
    "ReviewGradient": {
      "$swift": "ReviewGradient.swift",
      "$description": "HSL-interpolated review-progress color. ratio 0=fresh green → 1=due yellow → 2=overdue red → 3=deep purple.",
      "stops": [
        { "at": 0.00, "h": 160, "s": 48, "l": 38 },
        { "at": 0.15, "h": 150, "s": 44, "l": 40 },
        { "at": 0.30, "h": 138, "s": 42, "l": 42 },
        { "at": 0.45, "h": 122, "s": 38, "l": 44 },
        { "at": 0.60, "h": 105, "s": 38, "l": 45 },
        { "at": 0.72, "h":  85, "s": 40, "l": 46 },
        { "at": 0.85, "h":  60, "s": 48, "l": 46 },
        { "at": 1.00, "h":  45, "s": 55, "l": 48 },
        { "at": 1.30, "h":  28, "s": 65, "l": 44 },
        { "at": 2.00, "h":   4, "s": 58, "l": 40 },
        { "at": 3.00, "h": 278, "s": 50, "l": 34 }
      ],
      "interpolate": "hsl",
      "output": "rgb"
    }
  },

  "components": {
    "ListSectionCard": {
      "$swift": "ListSectionCard.swift",
      "$description": "Container card for grouped list rows. Single border + shadow, internal dividers separate items.",
      "css": {
        "className": "kg-list-section",
        "properties": {
          "background": { "var": "--card-bg" },
          "border": { "expr": "var(--sp-hairline) solid color-mix(in srgb, var(--card-border) 70%, transparent)" },
          "borderRadius": { "var": "--radius-card" },
          "boxShadow": { "var": "--elevation-z1" },
          "overflow": "hidden"
        }
      }
    },

    "VocabFilterChipBar": {
      "$swift": "AppFilterChipBar.swift + AppTabSelector.swift (appChipLabel / AppTabSelectorStyle.vocab)",
      "$description": "Pinned multi-select review-state filter chips. Equal-width pills inside ONE recessed container (mirrors iOS AppFilterChipBar's RoundedRectangle group); idle chip = transparent, selected = mutedFill; each chip carries a mono count capsule. No '全部' chip — empty selection = all (iOS multi-select semantics). Active count fill (primaryText@8%) is a contextual override hand-authored in styles.css since it depends on parent --active state.",
      "css": {
        "className": "kg-filter-bar__chips",
        "properties": {
          "display": "flex",
          "alignItems": "center",
          "gap": { "var": "--sp-2" },
          "background": { "var": "--stage-bg" },
          "borderRadius": { "expr": "calc(var(--radius-control) + 4px)" },
          "padding": { "var": "--sp-tiny" }
        }
      },
      "children": {
        "chip": {
          "css": {
            "className": "kg-filter-bar__chip",
            "properties": {
              "flex": "1",
              "display": "inline-flex",
              "alignItems": "center",
              "justifyContent": "center",
              "gap": "6px",
              "fontFamily": { "var": "--font-sans" },
              "fontSize": { "var": "--text-caption" },
              "fontWeight": "700",
              "color": { "var": "--text-secondary" },
              "background": "transparent",
              "padding": { "var": "--sp-2" },
              "borderRadius": { "var": "--radius-pill" },
              "cursor": "pointer",
              "whiteSpace": "nowrap",
              "transition": { "expr": "background var(--motion-quick), color var(--motion-quick)" }
            },
            "modifiers": {
              "active": {
                "background": { "var": "--muted-fill" },
                "color": { "var": "--text-primary" }
              }
            }
          }
        },
        "count": {
          "css": {
            "className": "kg-filter-bar__count",
            "properties": {
              "minWidth": "26px",
              "textAlign": "center",
              "fontFamily": { "var": "--font-mono" },
              "fontWeight": "700",
              "fontVariantNumeric": "tabular-nums",
              "padding": { "expr": "var(--sp-micro) 6px" },
              "borderRadius": { "var": "--radius-pill" },
              "background": { "var": "--muted-fill" }
            }
          }
        }
      }
    },

    "VocabRow": {
      "$swift": "KGVocabRow.swift + WordRow.swift",
      "$description": "Single vocabulary entry row. Flex row with content left, optional progress bar right.",
      "css": {
        "className": "kg-vocab-row",
        "properties": {
          "display": "flex",
          "alignItems": "center",
          "gap": { "var": "--sp-2" },
          "padding": { "expr": "14px var(--sp-4)" },
          "cursor": "pointer",
          "transition": { "var": "--motion-quick" }
        },
        "states": {
          "hover": { "background": { "var": "--muted-fill" } },
          "active": { "opacity": { "var": "--press-opacity" } }
        }
      },
      "children": {
        "content": {
          "css": {
            "className": "kg-vocab-row__content",
            "properties": {
              "flex": "1",
              "minWidth": "0",
              "display": "flex",
              "flexDirection": "column",
              "gap": { "var": "--sp-tiny" }
            }
          }
        },
        "topRow": {
          "css": {
            "className": "kg-vocab-row__top",
            "properties": {
              "display": "flex",
              "alignItems": "baseline",
              "gap": { "var": "--sp-tiny" }
            }
          }
        },
        "word": {
          "css": {
            "className": "kg-vocab-row__word",
            "properties": {
              "fontFamily": { "var": "--font-mono" },
              "fontSize": { "var": "--text-row-word" },
              "fontWeight": "600",
              "color": { "var": "--text-primary" },
              "lineHeight": { "var": "--leading-heading" },
              "whiteSpace": "nowrap",
              "overflow": "hidden",
              "textOverflow": "ellipsis"
            }
          }
        },
        "pos": {
          "css": {
            "className": "kg-vocab-row__pos",
            "properties": {
              "fontFamily": { "var": "--font-sans" },
              "fontSize": { "var": "--text-caption" },
              "fontWeight": "700",
              "color": { "var": "--text-tertiary" },
              "lineHeight": { "var": "--leading-caption" },
              "flexShrink": "0"
            }
          }
        },
        "trailingLabel": {
          "css": {
            "className": "kg-vocab-row__trailing",
            "properties": {
              "marginLeft": "auto",
              "fontFamily": { "var": "--font-mono" },
              "fontSize": { "var": "--text-caption" },
              "fontWeight": "700",
              "color": { "var": "--text-secondary" },
              "whiteSpace": "nowrap",
              "flexShrink": "0",
              "fontVariantNumeric": "tabular-nums"
            }
          }
        },
        "meaning": {
          "css": {
            "className": "kg-vocab-row__meaning",
            "properties": {
              "fontFamily": { "var": "--font-sans" },
              "fontSize": { "var": "--text-subhead" },
              "color": { "var": "--text-secondary" },
              "lineHeight": { "var": "--leading-body" },
              "whiteSpace": "nowrap",
              "overflow": "hidden",
              "textOverflow": "ellipsis"
            }
          }
        },
        "metadata": {
          "css": {
            "className": "kg-vocab-row__meta",
            "properties": {
              "display": "flex",
              "alignItems": "center",
              "gap": { "var": "--sp-1" },
              "fontFamily": { "var": "--font-sans" },
              "fontSize": { "var": "--text-caption" },
              "color": { "var": "--text-tertiary" },
              "lineHeight": { "var": "--leading-caption" }
            }
          }
        },
        "progressBar": {
          "css": {
            "className": "kg-vocab-row__progress",
            "properties": {
              "flexShrink": "0",
              "display": "flex",
              "flexDirection": "column",
              "alignItems": "flex-end",
              "gap": { "var": "--sp-micro" },
              "width": "104px"
            }
          },
          "children": {
            "label": {
              "css": {
                "className": "kg-vocab-row__progress-label",
                "properties": {
                  "fontFamily": { "var": "--font-mono" },
                  "fontSize": { "var": "--text-caption2" },
                  "fontWeight": "700",
                  "color": { "var": "--text-secondary" },
                  "whiteSpace": "nowrap",
                  "fontVariantNumeric": "tabular-nums"
                }
              }
            },
            "track": {
              "css": {
                "className": "kg-vocab-row__progress-track",
                "properties": {
                  "width": "100%",
                  "height": "5px",
                  "background": { "var": "--progress-track" },
                  "borderRadius": { "var": "--radius-pill" },
                  "overflow": "hidden"
                }
              }
            },
            "fill": {
              "css": {
                "className": "kg-vocab-row__progress-fill",
                "properties": {
                  "height": "100%",
                  "borderRadius": { "var": "--radius-pill" },
                  "transition": { "var": "--motion-control" }
                }
              }
            }
          }
        },
        "divider": {
          "css": {
            "className": "kg-vocab-row__divider",
            "properties": {
              "height": { "var": "--sp-hairline" },
              "background": { "var": "--divider" },
              "marginLeft": { "var": "--sp-4" }
            }
          }
        }
      }
    }
  }
}
