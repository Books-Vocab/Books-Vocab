{
  "schema": "kg.capture.profile.v1",
  "id": "marketing_account",
  "snapshot": {
    "source": "spec-emit",
    "specFile": "ops/demo/marketing_account/marketing_account_spec.json",
    "planFile": "ops/demo/marketing_account/history_plan.json",
    "destination": "platform=iOS Simulator,name=iPhone 17 Pro Max",
    "groups": [],
    "scenarios": [
      "Knowledge Graph View/Populated graph",
      "Vocabulary List View/Populated · mixed sync states",
      "Notebook List View/Populated · multiple notebooks",
      "Stats View/Populated",
      "Today Review/Back"
    ]
  },
  "render": {
    "variant": "app-store",
    "target": "promotion",
    "sourceMode": "snapshot-derived"
  },
  "shots": [
    {
      "id": "knowledge_graph",
      "sourceScenario": "Knowledge Graph View/Populated graph",
      "outputName": "final_01_knowledge_graph.png",
      "appearance": "light",
      "copy": {
        "title": "你讀過的字，連成一張網",
        "subtitle": "每個生字如何彼此關聯，一眼看見。"
      }
    },
    {
      "id": "vocab_list",
      "sourceScenario": "Vocabulary List View/Populated · mixed sync states",
      "outputName": "final_02_vocab_list.png",
      "appearance": "light",
      "copy": {
        "title": "從閱讀裡撈起的詞庫",
        "subtitle": "真實累積、帶著複習節奏的每個生字。"
      }
    },
    {
      "id": "notebook",
      "sourceScenario": "Notebook List View/Populated · multiple notebooks",
      "outputName": "final_03_notebook.png",
      "appearance": "light",
      "copy": {
        "title": "依主題整理你的字",
        "subtitle": "像整理思緒一樣，把單字分進不同的本子。"
      }
    },
    {
      "id": "stats",
      "sourceScenario": "Stats View/Populated",
      "outputName": "final_04_stats.png",
      "appearance": "light",
      "copy": {
        "title": "看得見的堅持",
        "subtitle": "連續學習與學習日曆，讓進度成為習慣。"
      }
    },
    {
      "id": "today_review",
      "sourceScenario": "Today Review/Back",
      "outputName": "final_05_today_review.png",
      "appearance": "light",
      "copy": {
        "title": "記住，而非背過",
        "subtitle": "間隔重複，每天幾分鐘變成長期記憶。"
      }
    }
  ]
}
