<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>card_count_plural</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@cards@</string>
		<key>cards</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld card</string>
			<key>other</key>
			<string>%lld cards</string>
		</dict>
	</dict>
	<key>vocab_graph_node_count_plural</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld word</string>
			<key>other</key>
			<string>%lld words</string>
		</dict>
	</dict>
	<key>vocab_graph_link_count_plural</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld link</string>
			<key>other</key>
			<string>%lld links</string>
		</dict>
	</dict>
	<key>vocab_total_cards_plural</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld card</string>
			<key>other</key>
			<string>%lld cards</string>
		</dict>
	</dict>
	<key>vocab_due_cards_plural</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld due</string>
			<key>other</key>
			<string>%lld due</string>
		</dict>
	</dict>
	<key>vocab_reviewed_cards_plural</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld reviewed today</string>
			<key>other</key>
			<string>%lld reviewed today</string>
		</dict>
	</dict>
	<key>已收錄 %d 個單字，其中 %d 個待複習。</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@collected@, %2$#@due@.</string>
		<key>collected</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%d collected word</string>
			<key>other</key>
			<string>%d collected words</string>
		</dict>
		<key>due</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%d due for review</string>
			<key>other</key>
			<string>%d due for review</string>
		</dict>
	</dict>
	<key>已收錄 %d 個單字，去複習鞏固記憶吧。</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@collected@ Review to reinforce your memory.</string>
		<key>collected</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>You have %d collected word.</string>
			<key>other</key>
			<string>You have %d collected words.</string>
		</dict>
	</dict>
</dict>
</plist>
