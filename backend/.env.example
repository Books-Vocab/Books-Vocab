OPENAI_API_KEY=sk-...

# Authentication
# JWT_SECRET must be at least 16 characters. The server will refuse to start otherwise.
JWT_SECRET=your-secret-key-change-in-production
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
APPLE_BUNDLE_ID=com.Max0228.BooksBrowser
APP_STORE_CONNECT_ISSUER_ID=your-app-store-connect-issuer-id
APP_STORE_CONNECT_KEY_ID=your-app-store-connect-key-id
APP_STORE_CONNECT_PRIVATE_KEY_PATH=/app/certs/AuthKey_XXXX.p8
APP_STORE_ROOT_CA_PATH=/app/certs/apple_root_ca.pem
DEBUG_BYPASS_SUBSCRIPTION=0
PRO_DEVELOPER_BYPASS_USER_IDS=

# Sentry error tracking (opt-in: leave SENTRY_DSN empty to disable)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE is auto-populated from KG_VERSION when unset
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_PROFILES_SAMPLE_RATE=0.0

# Mochi keys are user-scoped and should be stored via /api/user/config,
# not as a primary system env. Keep MOCHI_API_KEY only for legacy admin scripts if needed.
