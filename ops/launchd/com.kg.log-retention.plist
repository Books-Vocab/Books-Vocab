<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  KG log retention：每日修剪五個 log SQLite（pipeline_runs、judge_log、translate_log
  與共用其保留窗的 translate_cache_hits、token_usage、llm_errors）超過保留窗的列（#2091）。
  在此之前唯一觸發是手動 POST /api/admin/log-retention/run，log DB 無上限成長。

  跑在常駐機 felix。生產 Python 只存在於容器 knowledge-graph-api（主機沒有 backend venv），
  所以是 docker exec 進容器跑既有 CLI kg.log_retention（全部 DB、JSON 報告；旗標原文見
  ProgramArguments，XML 註解內不能出現連續兩個 hyphen）。容器環境就是 API 進程的環境：
  .env 的 *_RETENTION_DAYS 對本 job 與 admin 面板一致生效；以容器 USER appuser 執行。

  排程：StartCalendarInterval 用 LOCAL 時間，felix 是 Asia/Taipei。04:17 是離峰，且遠離
  com.kg.backup 的 11:00：備份 tar 的是同一批正在使用的 SQLite 檔，與大量 DELETE 同時跑
  可能打包到撕裂的檔案；先修剪也讓當天備份變小。RunAtLoad=false：積壓最多的第一次修剪
  不在 bootstrap 當下（白天）跑。一次性 job，不 KeepAlive。reconciler 重建容器打斷時
  DELETE 交易回滾，隔天再跑。

  報告：每次一行 JSON（每表 deleted、remaining、days）寫入 kg_log_retention.out.log；
  失敗的 traceback 寫入 .err.log，最後 exit code 見 launchctl print。
  失效偵測：GET /api/admin/observability 的 log_db_health.TABLE.overdue 與
  log_retention_overdue（最舊列早於 2 倍保留窗 = 本 job 沒在跑）。

  啟用／停用（由操作者手動 bootstrap，非預設掛載）：
    cp ops/launchd/com.kg.log-retention.plist ~/Library/LaunchAgents/com.kg.log-retention.plist
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.kg.log-retention.plist
    停用：launchctl bootout gui/$(id -u)/com.kg.log-retention
    手動跑一次：launchctl kickstart -p gui/$(id -u)/com.kg.log-retention
  它是 LaunchAgent（per-user）：跑在 auto-login 的 chenliangyu session（OrbStack docker 就緒）。
  PATH 與 com.kg.reconcile 相同，含 OrbStack 的 docker CLI。
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.kg.log-retention</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/env</string>
        <string>docker</string>
        <string>exec</string>
        <string>knowledge-graph-api</string>
        <string>python</string>
        <string>-m</string>
        <string>kg.log_retention</string>
        <string>--all</string>
        <string>--json</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/chenliangyu/.orbstack/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
    </dict>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>4</integer>
        <key>Minute</key>
        <integer>17</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>ProcessType</key>
    <string>Background</string>

    <key>StandardOutPath</key>
    <string>/Users/chenliangyu/Library/Logs/kg_log_retention.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/chenliangyu/Library/Logs/kg_log_retention.err.log</string>
</dict>
</plist>
