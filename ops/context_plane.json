    },
    {
      "id": "role.delivery-child",
      "match": {"roles": ["delivery-child"]},
      "units": ["agent-context.role.delivery-child", "worktree.boundary", "worktree.child-stop", "worktree.child-handoff"]
    },
    {
      "id": "role.review-service",
      "match": {"roles": ["review-service"]},
      "units": ["agent-context.role.review", "worktree.review", "receipt.core"]
    },
    {
      "id": "surface.docs",
      "match": {"roles": ["*"], "surfaces": ["docs"]},
      "units": ["kernel.doc-routing", "docs-control.authority", "docs-control.flow", "docs-control.surface", "sop.docs-sync"]
    },
    {
      "id": "surface.backend",
      "match": {"roles": ["*"], "surfaces": ["backend"]},
      "units": ["tech-index.environment", "sop.backend.testing"]
    },
    {
      "id": "surface.ios",
      "match": {"roles": ["*"], "surfaces": ["ios"]},
      "units": ["tech-index.ios-modules", "sop.ios.testing"]
    },
    {
      "id": "surface.release",
      "match": {"roles": ["*"], "surfaces": ["release"]},
      "units": ["sop.release.model"]
    },
    {
      "id": "task.review",
      "match": {"roles": ["*"], "tasks": ["review"]},
      "units": ["worktree.review", "receipt.core"]
    },
    {
      "id": "task.backend-routing",
      "match": {"roles": ["*"], "tasks": ["backend-routing"]},
      "units": ["tech-index.backend-routers"]
    },
    {
      "id": "task.handback",
      "match": {"roles": ["delivery-child"], "tasks": ["handback"]},
      "units": ["worktree.child-stop", "worktree.child-handoff", "receipt.core"]
    },
    {
      "id": "skill.app-debug",
      "match": {"roles": ["*"], "skills": ["app-debug"]},
      "units": ["skill.app-debug.kernel"]
    },
    {
      "id": "skill.billing",
      "match": {"roles": ["*"], "skills": ["billing"]},
      "units": ["skill.billing.kernel"]
    },
    {
      "id": "skill.data-analysis",
      "match": {"roles": ["*"], "skills": ["data-analysis"]},
      "units": ["skill.data-analysis.kernel"]
    },
    {
      "id": "skill.devops",
      "match": {"roles": ["*"], "skills": ["devops"]},
      "units": ["skill.devops.kernel"]
    },
    {
      "id": "skill.ios-simulator",
      "match": {"roles": ["*"], "skills": ["ios-simulator-verification"]},
      "units": ["skill.ios-simulator.kernel"]
    },
    {
      "id": "skill.ios-visual",
      "match": {"roles": ["*"], "skills": ["ios-visual-report-workflow"]},
      "units": ["skill.ios-visual.kernel"]
    },
    {
      "id": "skill.podcast",
      "match": {"roles": ["*"], "skills": ["podcast"]},
      "units": ["skill.podcast.kernel"]
    },
    {
      "id": "skill.release",
      "match": {"roles": ["*"], "skills": ["source-command-release"]},
      "units": ["skill.release.kernel"]
    },
    {
      "id": "task.feature-existence.ios",
      "match": {"roles": ["*"], "tasks": ["feature-existence"], "surfaces": ["ios"]},
      "units": ["product-surface.ios"]
    },
    {
      "id": "task.feature-existence.backend",
      "match": {"roles": ["*"], "tasks": ["feature-existence"], "surfaces": ["backend"]},
      "units": ["product-surface.backend"]
    }
