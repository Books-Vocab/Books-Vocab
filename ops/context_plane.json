{
  "schema": "kg.context_plane.v4",
  "version": 4,
  "registry": "docs/registry.yml",
  "onboarding": {
    "source": "docs/reference/project_onboarding.md",
    "required": true
  },
  "route_policy": {
    "coordination": "github-coordination",
    "implementation": "delivery-worktree",
    "implementation-ios": "ui-test-evidence",
    "review": "code-review",
    "docs": "skill-doc-sync",
    "release": "release-command"
  },
  "specialist_sources": {
    "bug": ["docs/sop/debug.md"],
    "test-failure": ["docs/sop/debug.md"],
    "unexpected-behavior": ["docs/sop/debug.md"],
    "user-data-analysis": ["docs/sop/data_analysis.md"],
    "graph-analysis": ["docs/sop/data_analysis.md"],
    "embedding-analysis": ["docs/sop/data_analysis.md"],
    "quota-analysis": ["docs/sop/data_analysis.md"],
    "simulator-verification": ["docs/sop/ios.md", "docs/sop/ui_flow_evidence.md"],
    "ui-test-evidence": ["docs/sop/ios.md", "docs/sop/ui_flow_evidence.md"],
    "visual-report-rebuild": ["docs/sop/ios.md", "docs/sop/ui-design.md", "docs/sop/ui_flow_evidence.md"],
    "docs-audit": ["docs/sop/doc_sync.md", "docs/registry.yml"],
    "docs-impact": ["docs/sop/doc_sync.md", "docs/registry.yml"],
    "docs-lint": ["docs/sop/doc_sync.md", "docs/registry.yml"],
    "skill-doc-sync": ["docs/sop/doc_sync.md", "docs/registry.yml"],
    "read-only-audit": ["docs/sop/doc_sync.md", "docs/registry.yml"],
    "production-status": ["docs/sop/debug.md", "docs/reference/host_topology.md", "docs/policy/safety.md"],
    "deploy": ["docs/sop/deploy.md", "docs/sop/debug.md", "docs/policy/safety.md"],
    "maintenance": ["docs/sop/deploy.md", "docs/sop/debug.md", "docs/policy/safety.md"],
    "remote-operation": ["docs/sop/deploy.md", "docs/sop/debug.md", "docs/policy/safety.md"],
    "app-store-release": ["docs/sop/release.md", "docs/sop/ios.md"],
    "version-release": ["docs/sop/release.md", "docs/sop/ios.md"],
    "podcast-monitor": ["docs/sop/podcast_pipeline.md"],
    "podcast-pipeline": ["docs/sop/podcast_pipeline.md"],
    "podcast-publish": ["docs/sop/podcast_pipeline.md"],
    "billing": ["docs/sop/cost_review.md", "docs/reference/cost_baseline.md"],
    "cost": ["docs/sop/cost_review.md", "docs/reference/cost_baseline.md"],
    "quota-cost": ["docs/sop/cost_review.md", "docs/reference/cost_baseline.md"],
    "token-spend": ["docs/sop/cost_review.md", "docs/reference/cost_baseline.md"]
  },
  "identities": {
    "cm": {
      "label": "CM",
      "aliases": ["cm", "codebase manager", "codebase-manager"],
      "machine_role": "manager",
      "allowed_intents": ["delivery", "release"],
      "entry_modes": ["coordination", "merge"],
      "route_classes": {
        "delivery": {"coordination": "coordination", "merge": "coordination"},
        "release": {"coordination": "coordination", "merge": "release"}
      },
      "owns": "交付協調、exact Ready admission、merge queue/merge、local main 與 origin/main 同步、版本與 release/deploy 邊界",
      "not_owns": "產品 code、Worker/Issue Solver worktree、PR body/registry 修正、代替 IM push/open PR、未批准的 production 寫入",
      "allowed_surfaces": ["github:pr-read", "github:merge-queue", "github:merge", "local:main-ff-only-sync", "local:read-only-worktree-audit"],
      "forbidden_surfaces": ["local:code-edit", "local:worker-worktree-write", "github:issue-write", "github:pr-body-write", "github:branch-push", "github:branch-delete"],
      "handoff_contract": {
        "input": ["exact PR base/HEAD/Scope", "required/readiness and CR/DS evidence"],
        "output": ["merge/return decision", "local main == origin/main after landing"],
        "terminal_cleanup_owner": "IM removes local worktree, local branch, and remote branch after CM terminal receipt"
      },
      "assignment_requirements": {
        "coordination": ["GitHub Issue/PR or direct assignment", "Scope decision"],
        "merge": ["GitHub PR", "required checks", "CR/DS result"]
      },
      "skill_routes": {
        "delivery": {"coordination": "github-coordination", "merge": "github-coordination"},
        "release": {"coordination": "github-coordination", "merge": "release-command"}
      },
      "specialist_routes": {
        "delivery": {"coordination": ["billing", "cost", "quota-cost", "token-spend", "user-data-analysis", "graph-analysis", "embedding-analysis", "quota-analysis"], "merge": ["billing", "cost", "quota-cost", "token-spend", "user-data-analysis", "graph-analysis", "embedding-analysis", "quota-analysis"]},
        "release": {"coordination": ["production-status"], "merge": ["production-status"]}
      }
    },
    "im": {
      "label": "IM",
      "aliases": ["im", "issues manager", "issues-manager"],
      "machine_role": "manager",
      "allowed_intents": ["delivery"],
      "entry_modes": ["issue-planning", "direct-assignment"],
      "route_classes": {
        "delivery": {"issue-planning": "coordination", "direct-assignment": "coordination"}
      },
      "owns": "GitHub Issue/Project 收件、排序、拆解、派工；本地 worktree lifecycle；exact Worker commit 的 push；PR 建立、metadata、readiness 與 terminal cleanup",
      "not_owns": "修改產品 code、替 Worker commit/解 code conflict、CR/DS 結論、merge queue/merge、release/deploy",
      "allowed_surfaces": ["github:issue-write", "github:project-write", "github:pr-write", "github:branch-push", "github:branch-delete-after-terminal", "local:worktree-lifecycle", "local:read-only-gate"],
      "forbidden_surfaces": ["local:code-edit", "local:staging", "local:code-commit", "local:conflict-resolution", "github:merge", "github:review-decision"],
      "handoff_contract": {
        "input": ["GitHub Issue or direct assignment", "clean local Worker/Issue Solver hand-back"],
        "output": ["one real PR with exact worker HEAD", "terminal triad cleanup after CM decision"],
        "pr_invariant": "local hand-back is not complete until a real PR exists for CM"
      },
      "assignment_requirements": {
        "issue-planning": ["GitHub Issue", "Project priority/triage"],
        "direct-assignment": ["具名 assignment", "acceptance", "Scope"]
      },
      "skill_routes": {
        "delivery": {"issue-planning": "github-coordination", "direct-assignment": "github-coordination"}
      },
      "specialist_routes": {
        "delivery": {"issue-planning": [], "direct-assignment": []}
      }
    },
    "worker": {
      "label": "Worker",
      "aliases": ["worker", "direct worker"],
      "machine_role": "contributor",
      "allowed_intents": ["delivery", "backend", "ios"],
      "entry_modes": ["direct-assignment"],
      "route_classes": {
        "delivery": {"direct-assignment": "implementation"},
        "backend": {"direct-assignment": "implementation"},
        "ios": {"direct-assignment": "implementation-ios"}
      },
      "owns": "直接指派工作的 local branch/worktree、程式碼、測試、local commit 與 hand-back evidence",
      "not_owns": "GitHub Issue/PR/branch mutation、push、review、merge、enqueue、Issue lifecycle、Project priority、release/deploy",
      "allowed_surfaces": ["local:assigned-worktree", "local:code-edit", "local:test", "local:git-commit", "local:hand-back"],
      "forbidden_surfaces": ["github:any-mutation", "github:issue-read-write", "github:pr-read-write", "github:push", "github:review", "github:merge", "local:other-worktree"],
      "handoff_contract": {
        "input": ["User/IM assignment", "dedicated branch/worktree and structured Scope"],
        "output": ["clean local commit with exact HEAD and validation evidence", "no GitHub mutation"],
        "next_owner": "IM publishes the exact commit as a PR",
        "dispatch_channels": {
          "im": {
            "discussion_with": "dispatching IM",
            "handback_policy": "same-dispatching-im"
          },
          "user": {
            "discussion_with": "User",
            "handback_policy": "specified-or-worker-selected-im"
          }
        }
      },
      "assignment_requirements": {
        "direct-assignment": ["User/IM assignment", "acceptance", "structured Scope", "dispatch_channel"]
      },
      "skill_routes": {
        "delivery": {"direct-assignment": "delivery-worktree"},
        "backend": {"direct-assignment": "delivery-worktree"},
        "ios": {"direct-assignment": "ui-test-evidence"}
      },
      "specialist_routes": {
        "delivery": {"direct-assignment": ["bug", "test-failure", "unexpected-behavior", "podcast-pipeline", "podcast-monitor"]},
        "backend": {"direct-assignment": ["bug", "test-failure", "unexpected-behavior", "user-data-analysis", "graph-analysis", "embedding-analysis", "quota-analysis"]},
        "ios": {"direct-assignment": ["simulator-verification", "ui-test-evidence", "visual-report-rebuild", "bug", "test-failure", "unexpected-behavior"]}
      }
    },
    "issue-solver": {
      "label": "Issue Solver",
      "aliases": ["issue solver", "issue-solver"],
      "machine_role": "contributor",
      "allowed_intents": ["delivery", "backend", "ios"],
      "entry_modes": ["issue"],
      "route_classes": {
        "delivery": {"issue": "implementation"},
        "backend": {"issue": "implementation"},
        "ios": {"issue": "implementation-ios"}
      },
      "owns": "由 IM 傳入 Issue assignment 的 local branch/worktree、程式碼、測試、local commit 與 hand-back evidence",
      "not_owns": "直接 GitHub access、Issue/PR/branch mutation、push、review、merge、enqueue、建立第二套 backlog、release/deploy",
      "allowed_surfaces": ["local:assigned-worktree", "local:code-edit", "local:test", "local:git-commit", "local:hand-back"],
      "forbidden_surfaces": ["github:any-mutation", "github:issue-read-write", "github:pr-read-write", "github:push", "github:review", "github:merge", "local:other-worktree"],
      "handoff_contract": {
        "input": ["IM-provided Issue assignment packet", "dedicated branch/worktree and structured Scope"],
        "output": ["clean local commit with exact HEAD and validation evidence", "no GitHub mutation"],
        "next_owner": "IM publishes the exact commit as a PR"
      },
      "assignment_requirements": {
        "issue": ["Issue assignment packet", "Issue acceptance", "structured Scope"]
      },
      "skill_routes": {
        "delivery": {"issue": "delivery-worktree"},
        "backend": {"issue": "delivery-worktree"},
        "ios": {"issue": "ui-test-evidence"}
      },
      "specialist_routes": {
        "delivery": {"issue": ["bug", "test-failure", "unexpected-behavior", "podcast-pipeline", "podcast-monitor"]},
        "backend": {"issue": ["bug", "test-failure", "unexpected-behavior", "user-data-analysis", "graph-analysis", "embedding-analysis", "quota-analysis"]},
        "ios": {"issue": ["simulator-verification", "ui-test-evidence", "visual-report-rebuild", "bug", "test-failure", "unexpected-behavior"]}
      }
    },
    "cr": {
      "label": "CR",
      "aliases": ["cr", "code reviewer", "code-reviewer"],
      "machine_role": "reviewer",
      "allowed_intents": ["review"],
      "entry_modes": ["pr-review"],
      "route_classes": {"review": {"pr-review": "review"}},
      "owns": "PR diff 的 correctness、tests、regression、architecture 與 security review",
      "not_owns": "修改 caller worktree、建立本地 review cycle、merge permission",
      "assignment_requirements": {
        "pr-review": ["GitHub PR", "exact HEAD", "required checks"]
      },
      "skill_routes": {
        "review": {"pr-review": "code-review"}
      },
      "specialist_routes": {
        "review": {"pr-review": []}
      }
    },
    "ds": {
      "label": "DS",
      "aliases": ["ds", "docs steward", "docs-steward"],
      "machine_role": "docs-steward",
      "allowed_intents": ["docs"],
      "entry_modes": ["pr-review"],
      "route_classes": {"docs": {"pr-review": "docs"}},
      "owns": "docs impact、registry、metadata、SoT 與 docs lint",
      "not_owns": "產品工作項目、PR lifecycle、merge、建立本地文件狀態庫",
      "assignment_requirements": {
        "pr-review": ["GitHub PR diff", "changed paths"]
      },
      "skill_routes": {
        "docs": {"pr-review": "skill-doc-sync"}
      },
      "specialist_routes": {
        "docs": {"pr-review": ["docs-audit", "docs-impact", "docs-lint", "skill-doc-sync", "read-only-audit"]}
      }
    },
    "release-operator": {
      "label": "Release operator",
      "aliases": ["release", "release operator", "release-operator"],
      "machine_role": "release-operator",
      "allowed_intents": ["release"],
      "entry_modes": ["release"],
      "route_classes": {"release": {"release": "release"}},
      "owns": "依 SOP 執行已批准的 release/deploy/rollback command",
      "not_owns": "自行批准 production、改變 PR merge 結論、繞過 safety wrapper",
      "assignment_requirements": {
        "release": ["explicit approval", "target", "rollback candidate", "health gate"]
      },
      "skill_routes": {
        "release": {"release": "release-command"}
      },
      "specialist_routes": {
        "release": {"release": ["production-status", "deploy", "maintenance", "remote-operation", "app-store-release", "version-release", "podcast-publish"]}
      }
    }
  },
  "roles": {
    "manager": {
      "identity_ids": ["cm", "im"],
      "sources": ["CLAUDE.md", "docs/reference/delivery_model.md", "docs/reference/agent_context.md", "docs/runbook/system.md"],
      "next_action": "read the GitHub Issue/PR and confirm Scope before mutation"
    },
    "contributor": {
      "identity_ids": ["worker", "issue-solver"],
      "sources": ["CLAUDE.md", "docs/reference/delivery_model.md", "docs/reference/agent_context.md", "docs/reference/tech_index.md"],
      "next_action": "work inside the declared branch/worktree Scope, commit locally, and hand back to IM for PR publication"
    },
    "reviewer": {
      "identity_ids": ["cr"],
      "sources": ["docs/reference/delivery_model.md", "docs/reference/agent_context.md", "docs/sop/review_discipline.md"],
      "next_action": "review the current PR diff and fresh required checks"
    },
    "docs-steward": {
      "identity_ids": ["ds"],
      "sources": ["docs/reference/delivery_model.md", "docs/reference/agent_context.md", "docs/sop/doc_sync.md", "docs/registry.yml"],
      "next_action": "run docs impact and docs lint for the changed surface"
    },
    "release-operator": {
      "identity_ids": ["release-operator"],
      "sources": ["docs/reference/delivery_model.md", "docs/sop/release.md", "docs/sop/deploy.md", "docs/policy/safety.md"],
      "next_action": "confirm explicit approval, target and rollback candidate before writing"
    }
  },
  "intents": {
    "delivery": {
      "skill": "worktree-flow",
      "skill_intent": "delivery-worktree",
      "sources": ["docs/reference/delivery_model.md", "docs/runbook/system.md"]
    },
    "review": {
      "skill": "code-review",
      "skill_intent": "code-review",
      "sources": ["docs/sop/review_discipline.md"]
    },
    "docs": {
      "skill": "kg-docs-control-plane",
      "skill_intent": "skill-doc-sync",
      "sources": ["docs/sop/doc_sync.md"]
    },
    "release": {
      "skill": "source-command-release",
      "skill_intent": "release-command",
      "sources": ["docs/sop/release.md"]
    },
    "backend": {
      "skill": "worktree-flow",
      "skill_intent": "delivery-worktree",
      "sources": ["docs/sop/backend.md", "docs/reference/tech_index.md"]
    },
    "ios": {
      "skill": "ios-simulator-verification",
      "skill_intent": "ui-test-evidence",
      "sources": ["docs/sop/ios.md", "docs/reference/tech_index.md"]
    }
  }
}
