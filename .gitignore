.DS_Store
backups/
plan/
dist/
# design-system/dist is canonical, not build output: kg-components.css is
# hand-authored and kg-tokens.css is the linkable artifact — track them.
!design-system/dist/
!design-system/dist/**
# Promotion screenshot dist files are canonical marketing deliverables.
!promotion/screenshots/dist/
!promotion/screenshots/dist/**

# lab/ — track source code only; ignore binaries/credentials/sandboxes
lab/podcast/workspaces/
lab/podcast/voice_samples/
lab/podcast/__pycache__/
lab/podcast/gen-lang-client-*.json
lab/podcast/.claude/
lab/podcast/.monitor.pid
lab/podcast/monitor.log
# .agents/ 只追蹤 skills（symlink → .claude/skills，單一來源），其餘 runtime 產物忽略
.agents/*
!.agents/skills

# Secrets
.env
.env.*
*.p8
*.pem
certs/

# IDE/user-specific
*.xcuserstate
*.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/

# Runtime data
backend/data/users/
# 用戶註冊表（含 config，可能帶 integrations api_key 等秘密）—— 絕不入庫
backend/data/users.json
# ops_edit 寫入備份 + 稽核軌跡（含用戶資料快照）—— 本地 runtime，不共享
backend/data/_ops_backups/
backend/data/_ops_edit_audit.jsonl
backend/data/*.db
backend/data/*.db-shm
backend/data/*.db-wal
backend/data/*.lock
*.npy

# Stray backend artifacts (root-level only; tests/ unaffected)
backend/*.png
backend/test_api.py
backend/test_option_b.py

# Python venv
.venv/

# Node.js
node_modules/

# Chrome visual-parity tool output (regenerable: node tools/shots.mjs + compare.mjs)
chrome-extension/tools/shots/
chrome-extension/tools/compare/
chrome-extension/tools/audit/

# Python cache in root if any
__pycache__/
.pytest_cache/
.cache/
# worktree_registry.py ledger — per-machine local state, anchored at
# <git-common-dir dirname>/.cache/worktree_registry.json (covered by .cache/ above;
# pinned explicitly for intent): NEVER commit.
.cache/worktree_registry.json
.worktrees/
.claude/worktrees/
.claude/scheduled_tasks.lock

# Codex tooling：AGENTS.md 與 .agents/skills 是 symlink → CLAUDE.md / .claude/skills
# （單一來源，已於上方追蹤）；.codex/ 為本地 runtime state，不共享
.codex/

# ops Swift tooling local build (wrapper redirects to .cache/ops-swift-build)
ops/swiftpm/.build/

# worktree-local symlinks to main repo (machine-specific, never commit)
/build
/node_modules

# 產物：由 `ops/backlog.py render --commit` 現地生成，不進版控。
# 進版控時它是每次 mutation 都要重寫的 291KB tracked 檔——並行分支唯一真的會衝突的
# 東西，且 render 是 O(entries) 故一波 n 筆立單是 O(n²)（實測 128 筆 16.2 秒）。
# 機器讀 store（`list --json` / `show`）；這個檔只是人要看單一檔案時的方便產物。
docs/runbook/improvement_backlog.md
